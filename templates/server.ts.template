import { Application, isHttpError, Status } from "jsr:@oak/oak";
import { oakCors } from "https://deno.land/x/oak_cors/mod.ts";
import "https://deno.land/std@0.224.0/dotenv/load.ts";

// Import local modules
import { router } from "./routes.ts";
import { pool } from "./db-client.ts";

const app = new Application();
const port = parseInt(Deno.env.get("PORT") || "8000", 10);

// --- Middleware ---

// Global Error Handler - must be first to catch all subsequent errors
app.use(async (ctx, next) => {
  try {
    await next();
  } catch (err) {
    console.error("Unhandled error:", err);
    if (isHttpError(err)) {
      ctx.response.status = err.status;
      ctx.response.body = { error: err.message };
    } else {
      // For unexpected errors, don't leak implementation details
      ctx.response.status = Status.InternalServerError;
      ctx.response.body = { error: "Internal Server Error" };
    }
  }
});

// CORS for cross-origin requests
app.use(oakCors()); // Enables CORS for all origins by default

// Logger & Timing
app.use(async (ctx, next) => {
  const start = Date.now();
  await next();
  const ms = Date.now() - start;
  ctx.response.headers.set("X-Response-Time", `${ms}ms`);
  console.log(
    `${ctx.request.method} ${ctx.request.url} - ${ctx.response.status} [${ms}ms]`,
  );
});

// --- Routes ---
app.use(router.routes());
app.use(router.allowedMethods());

// --- Server Start & Graceful Shutdown ---
const controller = new AbortController();
const { signal } = controller;

app.addEventListener("listen", ({ hostname, port, secure }) => {
  console.log(
    `🚀 Server listening on: ${secure ? "https://" : "http://"}${hostname ?? "localhost"}:${port}`,
  );
});

Deno.addSignalListener("SIGINT", async () => {
  console.log("\nGracefully shutting down...");
  controller.abort();
  await pool.end(); // Asynchronously close database connections
  console.log("Database pool closed.");
});

try {
  await app.listen({ port, signal });
} catch (e) {
  // Ignore AbortError which is expected on shutdown
  if (e.name !== "AbortError") {
    console.error("Server error:", e);
  }
}

console.log("Server has been shut down.");