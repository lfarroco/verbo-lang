# Copy to .env and fill in what you need:
#   cp .env.example .env
#
# Cloud AI providers (only the one you use is required):
GEMINI_KEY=
OPENAI_KEY=
ANTHROPIC_KEY=

# Local AI — docker-compose.yml provides an `ollama` service. The dev container
# defaults to http://ollama:11434 (in-compose). Set this explicitly if you run
# Ollama on the host instead.
OLLAMA_URL=

# Generated web-app database (matches the `db` service in docker-compose.yml):
PSQL_USER=postgres
PSQL_PASSWORD=postgres
PSQL_DB=verbo
PSQL_HOST=localhost
PSQL_PORT=55400
API_PORT=8000
